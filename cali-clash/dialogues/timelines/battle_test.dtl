[style name="battle_style"]
join chocolate center

chocolate: Oh? Such a cute little kiddo.
chocolate: What are you here for, boy?

# ROUND 1
- Try a bargain
	set {choice_id} = "A"
	[signal arg="choice_made"]
- Make a pun
	set {choice_id} = "B"
	[signal arg="choice_made"]
- Offer a friendly compliment
	set {choice_id} = "C"
	[signal arg="choice_made"]
- Stay quiet
	set {choice_id} = "D"
	[signal arg="choice_made"]
chocolate: {reaction_1}
